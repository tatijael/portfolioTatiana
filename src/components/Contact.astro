---
import { contact, cvUrl, site, socials } from '../data/site';

/**
 * Contacto: el cierre de la página.
 *
 * Un titular enorme en dos renglones, tres acciones y, debajo de un
 * filete, el pie: el copyright y la vuelta arriba. Sin caja ni fondo propio,
 * en el mismo idioma tipográfico que la apertura.
 *
 * Las acciones son exactamente tres, por pedido: escribir (mailto, el
 * principal), LinkedIn y el CV. No hay formulario: sin un endpoint
 * terminaría abriendo el cliente de mail igual, con más pasos.
 */
const linkedin = socials.find((s) => s.label === 'LinkedIn')?.href;
// El CV puede cambiar de formato: la descarga toma la extensión del archivo.
const extension = cvUrl?.match(/\.[a-z0-9]+$/i)?.[0] ?? '';
const anio = new Date().getFullYear();
---

<section
  id="contacto"
  class="pt-[var(--section-pad)] md:pt-[var(--section-pad-lg)]"
>
  <div class="air-container">
    <h2 class="ct__titulo air-reveal">
      {contact.titulo.map((linea) => <span>{linea}</span>)}
    </h2>

    <div class="ct__acciones air-reveal">
      <a href={`mailto:${site.email}`} class="air-btn-light ct__boton">{contact.escribir}</a>
      {
        linkedin && (
          <a href={linkedin} class="air-btn-ghost ct__boton" target="_blank" rel="noopener noreferrer">
            {contact.linkedin}
          </a>
        )
      }
      {
        cvUrl && (
          <a href={cvUrl} class="air-btn-ghost ct__boton" download={`Tatiana-Saucedo-CV${extension}`}>
            {contact.cv}
          </a>
        )
      }
    </div>

    <footer class="ct__pie">
      <p class="m-0">© {anio} {site.name}</p>
      <a href="#top" class="ct__arriba">Volver arriba</a>
    </footer>
  </div>
</section>

<style>
  .ct__titulo {
    margin: 0;
    font-family: var(--font-hero-display);
    font-weight: 800;
    font-size: clamp(3rem, 8.5vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--color-ink);
  }
  .ct__titulo span {
    display: block;
  }

  .ct__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(28px, 4vw, 48px);
  }
  .ct__boton {
    padding: 0.85em 1.6em;
    border-radius: var(--radius-pills);
  }
  /* En el teléfono los tres no entran en una línea: van uno por línea,
     centrados y del mismo ancho, en vez de dos arriba y uno suelto. */
  @media (max-width: 767px) {
    .ct__acciones {
      flex-direction: column;
      align-items: center;
    }
    .ct__boton {
      width: 80%;
      justify-content: center;
      text-align: center;
    }
  }

  .ct__pie {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    margin-top: clamp(80px, 12vw, 160px);
    padding: 20px 0 28px;
    border-top: 1px solid var(--hero-line);
    font-size: 0.8125rem;
    color: var(--hero-mist);
  }
  .ct__arriba {
    color: inherit;
    text-decoration: none;
  }
  .ct__arriba:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
