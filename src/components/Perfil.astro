---
import { perfil } from '../data/site';
import DualHeadline from './ui/DualHeadline.astro';
import { RevealText } from './react/RevealText';

/**
 * Perfil — "Lo que hago".
 *
 * Ocupa el lugar que dejó el hero. La pantalla de apertura dice quién es;
 * esta sección dice qué hace, nombrando las herramientas dentro de oraciones
 * que explican para qué sirve cada una.
 *
 * ── Por qué no es otra marquesina de fichas ──────────────────────────────
 *
 * Servicios ya tiene el stack como dos filas de chips que desfilan. Eso
 * responde "¿qué sabe usar?" pero no "¿qué hace con eso?", y es la segunda
 * pregunta la que decide una contratación. Por eso acá el stack va en prosa:
 * el nombre de la herramienta no es el contenido, es la prueba.
 *
 * ── El resaltado ─────────────────────────────────────────────────────────
 *
 * Los nombres marcados con *asteriscos* en site.ts se resaltan con peso y
 * tinta plena. Es sobre el texto: no decora la sección, señala dónde mirar.
 */

/**
 * Parte un texto en tramos, marcando cuáles van resaltados.
 *
 * `split` con un grupo de captura devuelve los separadores intercalados, así
 * que los índices impares son siempre el contenido de los asteriscos.
 */
function partir(texto: string) {
  return texto
    .split(/\*([^*]+)\*/g)
    .map((tramo, i) => ({ texto: tramo, destacado: i % 2 === 1 }));
}
---

<section
  id="perfil"
  class="py-[var(--section-pad)] md:py-[var(--section-pad-lg)]"
>
  <div class="air-container flex flex-col gap-[var(--section-gap)]">
    <div class="flex max-w-[52rem] flex-col gap-6">
      <h2 class="air-reveal air-eyebrow">{perfil.eyebrow}</h2>

      {/* Mismo revelado palabra por palabra que el resto de los titulares
          del sitio: se hereda, no se inventa uno nuevo. */}
      <RevealText client:idle>
        <DualHeadline
          before={perfil.headlineBefore}
          cursive={perfil.cursive}
          after={perfil.headlineAfter}
          as="h3"
        />
      </RevealText>

      <p class="air-reveal text-subheading font-normal text-balance text-ink/80">
        {perfil.lead}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        perfil.bloques.map((bloque) => (
          <article class="air-reveal air-card air-card--haze flex flex-col gap-3">
            <h4 class="text-caption font-medium tracking-wide text-rosewood">
              {bloque.titulo}
            </h4>
            <p class="text-body font-normal text-ink/75">
              {partir(bloque.texto).map((tramo) =>
                /* El contenido del span va en la MISMA línea a propósito: un
                   salto de línea acá se renderiza como un espacio dentro del
                   resaltado, y el resultado es "Remix , y cuando…" con el
                   espacio colgando antes de la coma. */
                tramo.destacado ? (
                  // prettier-ignore
                  <span class="perfil__stack">{tramo.texto}</span>
                ) : (
                  tramo.texto
                ),
              )}
            </p>
          </article>
        ))
      }
    </div>

    <p class="air-reveal text-caption font-normal text-ink/60">
      {perfil.cierre}
    </p>
  </div>
</section>

<style>
  /* Los nombres propios del stack se destacan solo por peso y tinta plena.
     Tenían un subrayado que se dibujaba al entrar, y se sacó: con tantos
     términos por tarjeta, el párrafo se leía como una lista de links. */
  .perfil__stack {
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
  }
</style>
