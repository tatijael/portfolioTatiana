---
import { site, hero } from '../data/site';

/**
 * Wordmark — la pantalla de apertura, al modelo de air.inc.
 *
 * El nombre entra grande, con el retrato al lado y el rol debajo, y al
 * scrollear se achica y viaja hasta quedar exactamente donde vive el logo de
 * la nav. El retrato y el rol no viajan: se apagan en el camino, así que el
 * relevo pasa en una pantalla en la que ya no queda nada más. Cuando llega, el de la
 * nav toma su lugar y este desaparece: no hay dos "Tati" en pantalla en
 * ningún momento, y el de la nav —que es el que se puede clickear— queda
 * intacto.
 *
 * ── Cómo está armado ─────────────────────────────────────────────────────
 *
 * Dos piezas separadas, y esa separación es lo que hace que funcione:
 *
 *   .wordmark        un espaciador de 100svh que vive EN EL FLUJO. No tiene
 *                    contenido. Su único trabajo es darle al scroll un
 *                    recorrido que consumir antes de llegar al hero.
 *
 *   .wordmark__layer una capa `fixed` con la palabra. Al estar fija, no se
 *                    mueve con el scroll: lo único que cambia es su
 *                    `transform`, que es trabajo de compositor.
 *
 * Si la palabra viviera dentro del espaciador, el navegador tendría que
 * componer un elemento que se mueve por scroll Y por transform a la vez, y
 * el aterrizaje sobre la nav se vuelve imposible de clavar al píxel.
 *
 * ── Por qué se mide y no se hardcodea ────────────────────────────────────
 *
 * El destino no es "arriba a la izquierda": es el rectángulo exacto del
 * glifo de la nav, que cambia con el ancho de la ventana (el contenedor
 * tiene max-width y padding elástico). Así que el script mide los dos
 * rectángulos reales —el grande y el de la nav— y calcula escala y
 * desplazamiento a partir de eso. Es la técnica FLIP. Si alguna vez cambia
 * el tamaño del logo de la nav o el ancho del contenedor, esto sigue
 * aterrizando bien sin tocar un número.
 *
 * ── Degradación ──────────────────────────────────────────────────────────
 *
 * Sin JS la pieza no existe: `display: none` por defecto y solo se enciende
 * bajo `html.js`. Con `prefers-reduced-motion` el script la desmonta y
 * devuelve el logo de la nav. En los dos casos el sitio arranca en el hero,
 * que es contenido real; esto es puro gesto.
 */
---

{/* `id="top"` es donde apunta el logo de la nav al clickearlo. Vivía en el
    hero; con el hero fuera, su lugar natural es este espaciador, que es lo
    primero del flujo y arranca exactamente en y=0. */}
<div class="wordmark" id="top" data-wordmark>
  <div class="wordmark__layer" data-wordmark-layer>
    {/* El rubor propio de esta pantalla. El hero tiene el suyo, y este se
        apaga al mismo ritmo que la palabra viaja: para cuando el hero
        aparece, el único rubor en pantalla es el del hero. */}
    <div class="wordmark__glow" data-wordmark-glow aria-hidden="true"></div>

    <div class="wordmark__row">
      <div class="wordmark__text">
        {/* aria-hidden porque es decorativo: el nombre accesible ya lo da el
            logo de la nav, que tiene su propio texto para lectores. */}
        <span class="wordmark__word" data-wordmark-word aria-hidden="true">
          {site.logoMark}
        </span>

        <p class="wordmark__role" data-wordmark-role>{hero.wordmarkRole}</p>

        {/* Heredadas del hero, que se desmontó. Son lo único de esta capa
            que se puede clickear: ver la nota de `pointer-events`. */}
        <div class="wordmark__ctas" data-wordmark-ctas>
          <a href={hero.primaryCta.href} class="air-btn-light">
            {hero.primaryCta.label}
          </a>
          <a href={hero.secondaryCta.href} class="air-btn-ghost">
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <figure class="wordmark__photo" data-wordmark-photo>
        <img
          src={hero.wordmarkPhoto}
          alt={hero.wordmarkPhotoAlt}
          width="972"
          height="1200"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>

    <p class="wordmark__hint" data-wordmark-hint aria-hidden="true">
      {hero.scrollHint}
    </p>
  </div>
</div>

<style>
  /* Espaciador: sin JS no ocupa nada y la página arranca en el hero. */
  .wordmark {
    display: none;
  }
  :global(html.js) .wordmark {
    display: block;
    height: 100svh;
  }

  .wordmark__layer {
    display: none;
  }
  :global(html.js) .wordmark__layer {
    display: grid;
    position: fixed;
    inset: 0;
    place-items: center;
    /* Por encima de la nav (z-40): mientras la palabra es grande tiene que
       pasar por delante de todo, y cuando aterriza ocupa el lugar del logo.
       No intercepta clicks en ningún momento — el logo clickeable es
       siempre el de la nav, que aparece justo cuando este se apaga. */
    z-index: 45;
    pointer-events: none;
  }

  /* Mismo rubor de dos radiales que el hero, para que el cambio de una
     pantalla a la otra no se lea como un cambio de fondo. */
  .wordmark__glow {
    position: absolute;
    inset: -20% 0 auto 0;
    height: 120%;
    background:
      radial-gradient(
        42% 46% at 40% 44%,
        color-mix(in srgb, var(--hero-blush) 95%, transparent) 0%,
        color-mix(in srgb, var(--hero-blush) 45%, transparent) 46%,
        transparent 74%
      ),
      radial-gradient(
        40% 44% at 64% 56%,
        color-mix(in srgb, var(--hero-peach) 85%, transparent) 0%,
        color-mix(in srgb, var(--hero-peach) 36%, transparent) 48%,
        transparent 76%
      );
  }

  /* ── La fila ──────────────────────────────────────────────────────────
     El nombre a la izquierda con el rol debajo, el retrato a la derecha, y
     la fila entera centrada en la pantalla.

     `--wordmark-size` es la medida madre: de ella salen el cuerpo del
     nombre, el del rol, el ancho del retrato y el aire del medio. Un solo
     número para mover y toda la composición acompaña sin descuadrarse. */
  .wordmark__row {
    /* El techo es para que en un monitor de 2560px la fila no se vuelva
       absurda; el piso es una red de seguridad que en la práctica no se
       activa. Ninguno de los dos tiene que morder en un tamaño de pantalla
       normal: si lo hace, el `min()` de arriba deja de mandar y la
       proporción de la fila se rompe. */
    --wordmark-size: clamp(1.5rem, min(15.75vw, 34svh), 26rem);

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--wordmark-size) * 0.26);
  }

  .wordmark__photo {
    flex: none;
    margin: 0;
    width: calc(var(--wordmark-size) * 1.35);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-images);
    /* La hairline pastel del sistema define el borde sin encerrar la foto en
       un marco, y la sombra corta la apoya sobre el papel. */
    box-shadow:
      0 0 0 1px var(--color-petal),
      0 18px 40px -24px rgb(0 0 0 / 0.35);
    will-change: opacity;
  }
  .wordmark__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La cara está a la izquierda y arriba del encuadre original. */
    object-position: 40% 28%;
  }

  .wordmark__text {
    text-align: center;
  }

  .wordmark__role {
    margin: calc(var(--wordmark-size) * 0.1) 0 0;
    font-family: var(--font-hero-mono);
    /* Atado a la medida madre para que la proporción con el nombre no cambie
       de pantalla a pantalla, pero con piso y techo: en mono, por debajo de
       10px un interletrado tan abierto se vuelve ilegible. */
    font-size: clamp(0.625rem, calc(var(--wordmark-size) * 0.1), 1rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    will-change: opacity;
  }

  .wordmark__ctas {
    display: flex;
    justify-content: center;
    gap: var(--element-gap);
    margin-top: calc(var(--wordmark-size) * 0.22);

    /* ── La excepción de la capa ────────────────────────────────────────
       `.wordmark__layer` es `pointer-events: none` entera, porque mientras
       el nombre es grande pasa por delante de todo y no puede robarle
       clicks a la nav. Estos dos botones son lo único que sí tiene que
       recibirlos, así que se los devuelve acá.

       Y por eso el script los apaga cuando se desvanecen: quedan en pantalla
       hasta que la capa se oculta al aterrizar, y un botón invisible que
       igual se puede clickear es una trampa. */
    pointer-events: auto;
    will-change: opacity;
  }

  /* En un teléfono "al lado" no entra: el nombre quedaría del tamaño de una
     línea de texto para dejarle sitio a una foto diminuta. Abajo de 600px la
     fila se da vuelta en columna —retrato arriba, nombre debajo— y el nombre
     recupera el ancho entero de la pantalla. */
  @media (max-width: 600px) {
    .wordmark__row {
      /* Acá no hay lugar para el 15.75vw de arriba: apilado, al nombre lo
         aprieta el ancho entero de la pantalla y 20vw es lo más grande que
         entra con margen. El retrato, en cambio, sí puede crecer —no compite
         con nadie por el ancho—, así que sube de 2.1 a 2.6 em.

         Y por eso el guard de alto es mucho más bajo que el 34svh de
         escritorio: en columna se suman todos los pisos, no solo el retrato.

             retrato 3.47 + aire 0.4 + nombre 0.75 + rol 0.2 = 4.82 em

         Para que la columna entre en el 72% de la pantalla sale 15svh. Con
         un número más alto el retrato empuja al nombre abajo del pliegue. */
      --wordmark-size: clamp(1.5rem, min(20vw, 15svh), 7rem);

      flex-direction: column-reverse;
      gap: calc(var(--wordmark-size) * 0.4);
    }
    .wordmark__photo {
      width: calc(var(--wordmark-size) * 2.6);
    }
  }

  .wordmark__word {
    position: relative;
    /* `inline-block` y no el `inline` de un span suelto: el script mide esta
       caja para calcular el viaje y la necesita del ancho del texto. */
    display: inline-block;
    font-family: var(--font-control-cursive);
    font-weight: var(--font-weight-medium);
    /* ── De dónde sale el 10.5vw de `--wordmark-size` ──────────────────
       El wordmark tiene que ocupar más o menos el mismo porcentaje del
       ancho en cualquier pantalla, y eso es justo lo que hace `vw`: la
       proporción no cambia. Así que el número se saca una sola vez,
       midiendo, y después vale para todos los anchos.

       Medido: "Tati Saucedo" en Caveat avanza 4.423 em, pero la TINTA va de
       0.166 a 4.347 em — o sea 4.181 em, y se sale de la caja que el
       navegador reserva. Solo cuando el nombre ocupaba el viewport entero
       eso alcanzaba para que la "o" final pareciera cortada.

       Ahora el nombre comparte la fila con el retrato y el aire del medio:

           tinta 4.181 + aire 0.26 + retrato 1.35 = 5.79 em de fila

       Para que la fila entre en el 91% del viewport sale 15.75vw, y quedan
       4.5 puntos de margen de cada lado. Es un hero apretado a propósito:
       el pedido fue que el conjunto se viera grande, y este es el tamaño
       máximo al que la fila entera todavía respira.

       El `min()` con svh es para las pantallas anchas y bajas, donde el que
       aprieta es el alto del retrato y no el ancho: el retrato mide 1.8 em
       de alto, así que 34svh es lo que lo deja en el 61% de la pantalla.

       Los números dependen del TEXTO: si cambia `site.logoMark` hay que
       volver a medirlo (poné el wordmark en 100px y leé
       `measureText().actualBoundingBoxLeft/Right`). */
    font-size: var(--wordmark-size);
    /* ── El aire de la caja, que acá no es decorativo ───────────────────
       `background-clip: text` solo pinta DENTRO de la caja del elemento. El
       trazo que se sale se queda sin degradado y, como el color es
       `transparent`, directamente no se ve. En una cursiva eso pasa todo el
       tiempo, y pasaba en los dos ejes:

         · Arriba, el punto de la "i" caía afuera con `line-height: 0.9`.
           1.15 le da a la caja el alto que la cursiva necesita.

         · A la derecha, la cola de la "o" de "Saucedo" se salía 9px. La
           tinta llega a 4.347 em pero el avance es 4.298, y el
           `letter-spacing` de abajo corre el último glifo otros 0.01 em sin
           agrandar su tinta. Neto: 0.039 em de cola afuera de la caja.
           `padding-inline: 0.08em` la cubre con margen.

       El relleno es simétrico a propósito: así el centro de la caja sigue
       siendo el centro del texto, que es lo que asume el cálculo de FLIP.
       Lo único que hay que descontar es el ancho — y el script lo hace. */
    line-height: 1.15;
    padding: 0.06em 0.08em;
    letter-spacing: 0.01em;
    white-space: nowrap;

    /* El degradado va de tinta a Rosewood en diagonal. Es la misma excepción
       que se permite el título del hero: la regla de "sin gradientes" de Air
       apunta a no simular profundidad en la UI, y esto es el tratamiento de
       un display. Las dos paradas pasan AA de sobra (15:1 y 5.84:1), así que
       la palabra se lee entera en cualquier punto del recorrido. */
    background-image: linear-gradient(
      152deg,
      var(--color-ink) 0%,
      color-mix(in oklab, var(--color-ink) 62%, var(--color-rosewood)) 46%,
      var(--color-rosewood) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;

    /* El origen en el centro es lo que asume el cálculo de FLIP del script:
       primero se traslada el centro, después se escala alrededor de él. */
    transform-origin: center center;
    will-change: transform;

    /* ── La pluma ───────────────────────────────────────────────────────
       El nombre no aparece: se escribe. La máscara es una banda opaca con
       un borde difuminado que barre de izquierda a derecha, y lo que va
       dejando atrás es el nombre ya trazado.

       Va inclinada 97° y no 90° para que el borde del barrido acompañe la
       inclinación de la cursiva: derecho, el filo cruzaba las letras en
       diagonal contra su propio ángulo y se leía como una persiana. Con la
       misma pendiente que la letra, se lee como la punta de una pluma.

       Mide 220% del ancho para que en el extremo del recorrido la parte
       transparente cubra el nombre entero — si midiera 100%, al empezar ya
       se vería media palabra.

       El valor de acá es el del FINAL: nombre completamente escrito. Ver el
       comentario largo de las animaciones para por qué el estado base tiene
       que ser siempre el último keyframe. */
    --wordmark-pluma: linear-gradient(
      97deg,
      #000 0 47%,
      transparent 57% 100%
    );
    -webkit-mask-image: var(--wordmark-pluma);
    mask-image: var(--wordmark-pluma);
    -webkit-mask-size: 220% 100%;
    mask-size: 220% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 0% 0;
    mask-position: 0% 0;
  }

  .wordmark__hint {
    position: absolute;
    bottom: var(--spacing-32);
    margin: 0;
    font-family: var(--font-hero-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--hero-mist);
    will-change: opacity;
  }

  /* ── Entrada, y por qué solo toca `opacity` ───────────────────────────
     Las tres capas aparecen al cargar, antes de que haya scroll. De ahí en
     adelante todo lo maneja el scroll, escribiendo `transform` y `opacity`
     inline desde el script.

     Y ahí está la trampa que hay que respetar: una animación CSS con
     `fill-mode: both` sigue imponiendo el valor de su último keyframe
     DESPUÉS de terminar, y le gana a cualquier estilo inline — las
     animaciones pisan al autor en la cascada. O sea que una entrada que
     animara `transform` dejaría a la palabra clavada en su `scale(1)` final
     y el viaje no se vería nunca, aunque el script estuviera escribiendo el
     transform correcto en cada frame.

     Por eso:
       1. la entrada de la palabra anima SOLO opacity, nunca transform. Así
          el transform del scroll funciona desde el primer frame, incluso
          mientras la entrada todavía corre.
       2. las tres animaciones se apagan (`.is-live`) en cuanto hay scroll o
          en cuanto terminan, lo que pase primero. Recién ahí el script puede
          mover también las opacidades del rubor y de la pista.

     El apagado no produce salto: el estado base del CSS es exactamente el
     último keyframe de cada animación. */
  :global(html.js) .wordmark__photo,
  :global(html.js) .wordmark__role,
  :global(html.js) .wordmark__ctas,
  :global(html.js) .wordmark__hint,
  :global(html.js) .wordmark__glow {
    animation: wordmark-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* El nombre tiene la suya: no se funde, se escribe.

     La curva arranca decidida y llega frenando, que es como se termina un
     trazo a mano — una lineal se leería como una barra de progreso. Dura más
     que los fundidos (1.4s contra 1.1s) porque tiene que recorrer el ancho
     del nombre y no solo pasar de 0 a 1. */
  :global(html.js) .wordmark__word {
    animation: wordmark-escritura 1.4s cubic-bezier(0.32, 0.08, 0.2, 1) both;
  }

  /* En cascada, y detrás de la pluma: el retrato entra cuando el nombre ya
     empezó, el rol cuando está casi escrito y la pista al final. El orden
     es el de importancia, no el de posición en pantalla. */
  :global(html.js) .wordmark__photo {
    animation-delay: 0.25s;
  }
  :global(html.js) .wordmark__role {
    animation-delay: 0.95s;
  }
  :global(html.js) .wordmark__ctas {
    animation-delay: 1.1s;
  }
  :global(html.js) .wordmark__hint {
    animation-delay: 1.35s;
  }

  .wordmark__layer.is-live .wordmark__word,
  .wordmark__layer.is-live .wordmark__photo,
  .wordmark__layer.is-live .wordmark__role,
  .wordmark__layer.is-live .wordmark__ctas,
  .wordmark__layer.is-live .wordmark__hint,
  .wordmark__layer.is-live .wordmark__glow {
    animation: none;
  }

  @keyframes wordmark-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Solo `mask-position`, nunca `transform`: es exactamente la misma trampa
     que se explica arriba. Un `fill-mode: both` sobre transform dejaría al
     nombre clavado y el viaje hacia la nav no se vería nunca. La máscara es
     una propiedad distinta, así que las dos cosas conviven: el nombre puede
     estar escribiéndose y viajando al mismo tiempo sin pelearse. */
  @keyframes wordmark-escritura {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }
</style>

<script>
  // ── El viaje del wordmark ───────────────────────────────────────────────
  // Ver el comentario del frontmatter para el porqué de la estructura. Acá
  // va el cómo.

  const panel = document.querySelector<HTMLElement>('[data-wordmark]');
  const layer = document.querySelector<HTMLElement>('[data-wordmark-layer]');
  const word = document.querySelector<HTMLElement>('[data-wordmark-word]');
  const glow = document.querySelector<HTMLElement>('[data-wordmark-glow]');
  const hint = document.querySelector<HTMLElement>('[data-wordmark-hint]');
  const photo = document.querySelector<HTMLElement>('[data-wordmark-photo]');
  const role = document.querySelector<HTMLElement>('[data-wordmark-role]');
  const ctas = document.querySelector<HTMLElement>('[data-wordmark-ctas]');
  // El glifo visible del logo de la nav, que es el destino del viaje.
  const destino = document.querySelector<HTMLElement>('[data-logo-mark]');
  const logo = document.querySelector<HTMLElement>('[data-logo]');

  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const desmontar = () => {
    // Sin la pieza, el hero vuelve a ser lo primero y el logo de la nav se
    // comporta como siempre.
    panel?.remove();
    layer?.remove();
    document.documentElement.classList.remove('wordmark-activo');
  };

  if (!panel || !layer || !word || !destino || !logo || quieto) {
    desmontar();
  } else {
    // Marca que la pieza está viva. La consumen dos reglas de otros
    // componentes: el hero retiene su animación de entrada hasta que la
    // palabra empieza a irse, y el logo de la nav se queda invisible
    // mientras el grande está en pantalla.
    document.documentElement.classList.add('wordmark-activo');

    let dx = 0;
    let dy = 0;
    let escala = 1;

    /**
     * Mide los dos rectángulos y calcula el viaje.
     *
     * La palabra se mide SIN transform: hay que conocer su caja natural,
     * porque el transform que se le aplica después se calcula a partir de
     * ella. Medirla ya transformada daría un resultado que se realimenta a
     * sí mismo y el aterrizaje se corre un poco en cada resize.
     */
    const medir = () => {
      const previo = word.style.transform;
      word.style.transform = 'none';
      const grande = word.getBoundingClientRect();
      word.style.transform = previo;

      const chico = destino.getBoundingClientRect();
      if (!grande.width || !chico.width) return;

      // `grande` es la caja del borde, o sea que incluye el relleno que le
      // pusimos para que el degradado cubra las colas de la cursiva. El logo
      // de la nav no lo tiene, así que para que las dos medidas hablen de lo
      // mismo hay que descontarlo: lo que se compara es texto contra texto.
      const cs = getComputedStyle(word);
      const relleno =
        parseFloat(cs.paddingLeft || '0') + parseFloat(cs.paddingRight || '0');
      const anchoTexto = grande.width - relleno;
      if (!anchoTexto) return;

      escala = chico.width / anchoTexto;
      // El centro no se toca: el relleno es simétrico, así que el centro de
      // la caja y el del texto son el mismo punto.
      dx = chico.left + chico.width / 2 - (grande.left + grande.width / 2);
      dy = chico.top + chico.height / 2 - (grande.top + grande.height / 2);
    };

    /**
     * Smoothstep: arranca lento, acelera en el medio y llega frenando.
     *
     * Antes era una ease-out pura (1 - (1-t)^2.4) y estaba mal elegida: con
     * esa curva, al 35% del scroll la palabra ya había hecho el 66% del
     * viaje. Se escapaba de golpe apenas tocabas la rueda y después se
     * arrastraba. Simétrica, la palabra se queda grande el primer tramo
     * —que es lo que hace que la apertura exista— y recién después se va.
     */
    const suavizar = (t: number) => t * t * (3 - 2 * t);

    let pendiente = false;
    let aterrizado: boolean | null = null;

    // Apaga las animaciones de entrada para que el script pueda escribir
    // `opacity` inline sin que el `fill-mode: both` se la pise. Ver el
    // comentario largo en el bloque de estilos.
    let vivo = false;
    const activar = () => {
      if (vivo) return;
      vivo = true;
      layer.classList.add('is-live');
    };
    // Tiene que esperar a la entrada MÁS LARGA de todas, que ahora es la de
    // la pista: 1.35s de espera más 1.1s de fundido. Si se apagara antes, la
    // pista quedaría clavada a mitad de camino.
    setTimeout(activar, 2550);

    const pintar = () => {
      pendiente = false;

      // El recorrido dura exactamente la altura del espaciador: cuando el
      // espaciador terminó de salir por arriba, la palabra ya llegó.
      const recorrido = panel.offsetHeight || window.innerHeight;
      const crudo = Math.min(1, Math.max(0, window.scrollY / recorrido));
      const p = suavizar(crudo);

      word.style.transform = `translate(${dx * p}px, ${dy * p}px) scale(${
        1 + (escala - 1) * p
      })`;

      // Todo lo que no viaja se va antes que la palabra: para la mitad del
      // recorrido ya no hay nada más que el nombre viajando, y el relevo con
      // el logo de la nav pasa en una pantalla limpia. Solo se tocan una vez
      // apagada la entrada, que hasta entonces manda sobre opacity.
      if (vivo) {
        if (glow) glow.style.opacity = String(Math.max(0, 1 - crudo * 1.6));
        if (hint) hint.style.opacity = String(Math.max(0, 1 - crudo * 3));
        // El retrato y el rol se apagan juntos y más rápido que el rubor:
        // son figura, no fondo, y arrastrarlos medio recorrido le sacaría el
        // protagonismo al viaje del nombre.
        const visible = Math.max(0, 1 - crudo * 2.4);
        const acompanan = String(visible);
        if (photo) photo.style.opacity = acompanan;
        if (role) role.style.opacity = acompanan;
        if (ctas) {
          ctas.style.opacity = acompanan;
          // Apagados apenas dejan de verse. Si no, siguen siendo
          // clickeables —invisibles, pero ahí— hasta que la capa entera se
          // oculta al final del recorrido.
          ctas.style.pointerEvents = visible > 0.05 ? 'auto' : 'none';
        }
      }

      // El relevo. Se hace una sola vez por cambio de estado y no en cada
      // frame, para no tocar el DOM sesenta veces por segundo.
      const llego = crudo >= 0.999;
      if (llego !== aterrizado) {
        aterrizado = llego;
        // Por debajo del umbral manda el grande; a partir de ahí, el de la
        // nav, que es el que se puede clickear.
        layer.style.visibility = llego ? 'hidden' : 'visible';
        logo.style.visibility = llego ? 'visible' : 'hidden';
      }

      // El hero suelta su animación de entrada cuando la palabra ya se fue
      // lo suficiente como para que el hero esté entrando en pantalla. Si no,
      // su entrada se reproduce sola en una pantalla que nadie está mirando.
      if (crudo >= 0.4) {
        document.documentElement.classList.remove('wordmark-activo');
      }
    };

    const alScrollear = () => {
      // Scrollear es la señal de que la entrada ya no importa: si el usuario
      // se movió antes de que terminara, gana el viaje.
      if (window.scrollY > 0) activar();
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(pintar);
    };

    // Las fuentes cambian el ancho del wordmark al terminar de cargar, y con
    // él todo el cálculo. Se vuelve a medir cuando eso pasa.
    const remedir = () => {
      medir();
      pintar();
    };

    medir();
    pintar();

    document.fonts?.ready.then(remedir);
    addEventListener('scroll', alScrollear, { passive: true });
    addEventListener('resize', remedir, { passive: true });
  }
</script>
