---
import { site, hero, credencial } from '../data/site';

/**
 * Wordmark — la pantalla de apertura, al modelo de air.inc.
 *
 * Una credencial al centro que cae colgada de su cinta al cargar, se
 * balancea, se puede arrastrar y al pasar el mouse se da vuelta
 * (src/lib/credencial*.ts), delante del nombre gigante de fondo. Abajo, el
 * rol a la izquierda y los botones a la derecha. Al scrollear todo se
 * apaga y la cinta sube.
 *
 * (Hasta el 2026-10-13 acá estaba el nombre grande en 3D que viajaba hasta
 * el logo de la nav. Se sacó: con el nombre en la credencial sobraba. El
 * módulo src/lib/nombre3d.ts queda en el repo, desmontado.)
 *
 * ── Cómo está armado ─────────────────────────────────────────────────────
 *
 * Dos piezas separadas:
 *
 *   .wordmark        un espaciador de 100svh que vive EN EL FLUJO. No tiene
 *                    contenido. Su único trabajo es darle al scroll un
 *                    recorrido que consumir antes de llegar a Proyectos.
 *
 *   .wordmark__layer una capa `fixed` con todo lo que se ve. Al estar fija,
 *                    no se mueve con el scroll: lo que cambia es su
 *                    opacidad, y la credencial sube por su cuenta.
 *
 * ── Degradación ──────────────────────────────────────────────────────────
 *
 * Sin JS la pieza no existe: `display: none` por defecto y solo se enciende
 * bajo `html.js`. Con `prefers-reduced-motion` el script la desmonta y
 * devuelve el logo de la nav. En los dos casos el sitio arranca en el hero,
 * que es contenido real; esto es puro gesto.
 */
---

{/* `id="top"` es donde apunta el logo de la nav al clickearlo. Vivía en el
    hero; con el hero fuera, su lugar natural es este espaciador, que es lo
    primero del flujo y arranca exactamente en y=0. */}
<div class="wordmark" id="top" data-wordmark>
  <div class="wordmark__layer" data-wordmark-layer>
    {/* El rubor propio de esta pantalla. El hero tiene el suyo, y este se
        apaga al mismo ritmo que la palabra viaja: para cuando el hero
        aparece, el único rubor en pantalla es el del hero. */}
    <div class="wordmark__glow" data-wordmark-glow aria-hidden="true"></div>

    {/* El nombre gigante, detrás de todo. Se corta contra el borde
        derecho a propósito: no hace falta leerlo entero, el nombre completo
        está en la credencial. Es textura, por eso aria-hidden. */}
    <p class="wordmark__fondo" data-wordmark-fondo aria-hidden="true">
      {site.logoMark}
    </p>

    {/* El hueco de la credencial. En escritorio queda vacío y la dibuja el
        lienzo 3D, que se encuadra con este rectángulo; en táctil adentro
        va la versión plana. Ver src/lib/credencial.ts. */}
    <figure
      class="wordmark__photo credencial"
      data-wordmark-photo
      data-credencial={JSON.stringify(credencial)}
    >
      <div class="credencial__colgante">
        <span class="credencial__cinta" data-cinta aria-hidden="true"></span>
        <button
          type="button"
          class="credencial__tarjeta"
          data-tarjeta
          aria-pressed="false"
          aria-label="Dar vuelta la credencial"
        >
          <span class="credencial__cara" data-cara-frente></span>
          <span class="credencial__cara credencial__cara--dorso" data-cara-dorso></span>
        </button>
      </div>
      <figcaption class="sr-only">
        Credencial de {credencial.nombre} {credencial.apellido}, {credencial.rol}.
        {credencial.dorso.filas.map(([etiqueta, valor]) => `${etiqueta}: ${valor}. `)}
      </figcaption>
    </figure>

    {/* El pie: el rol abajo a la izquierda y los botones a la derecha, en
        el mismo ancho de contenedor que el resto del sitio. */}
    <div class="air-container wordmark__pie">
      <div class="wordmark__rol" data-wordmark-role>
        <p class="wordmark__rol-linea">{credencial.rol}</p>
        <p class="wordmark__rol-extra">{credencial.rolExtra}</p>
      </div>

      {/* Heredadas del hero, que se desmontó. Son lo único de esta capa,
          junto con la credencial plana, que se puede clickear: ver la nota
          de `pointer-events`. */}
      <div class="wordmark__ctas" data-wordmark-ctas>
        <a href={hero.primaryCta.href} class="air-btn-light">
          {hero.primaryCta.label}
        </a>
        <a href={hero.secondaryCta.href} class="air-btn-ghost">
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Espaciador: sin JS no ocupa nada y la página arranca en el hero. */
  .wordmark {
    display: none;
  }
  :global(html.js) .wordmark {
    display: block;
    height: 100svh;
  }

  .wordmark__layer {
    display: none;
  }
  :global(html.js) .wordmark__layer {
    display: grid;
    position: fixed;
    inset: 0;
    place-items: center;
    /* Por debajo de la nav (z-40): la cinta de la credencial sale de atrás
       de la barra, como si colgara del techo, y no tapa sus botones. La capa
       entera es transparente a los clicks salvo los botones y la credencial
       plana, que se los devuelven. */
    z-index: 35;
    /* El nombre de fondo es más ancho que la pantalla. */
    overflow: hidden;
    pointer-events: none;
  }

  /* Mismo rubor de dos radiales que el hero, para que el cambio de una
     pantalla a la otra no se lea como un cambio de fondo. */
  .wordmark__glow {
    position: absolute;
    inset: -20% 0 auto 0;
    height: 120%;
    background:
      radial-gradient(
        42% 46% at 40% 44%,
        color-mix(in srgb, var(--hero-blush) 95%, transparent) 0%,
        color-mix(in srgb, var(--hero-blush) 45%, transparent) 46%,
        transparent 74%
      ),
      radial-gradient(
        40% 44% at 64% 56%,
        color-mix(in srgb, var(--hero-peach) 85%, transparent) 0%,
        color-mix(in srgb, var(--hero-peach) 36%, transparent) 48%,
        transparent 76%
      );
  }

  /* ── La composición ──────────────────────────────────────────────────
     Tres planos: el nombre gigante al fondo, la credencial colgando al
     centro, y el pie con el rol y los botones. Todo en absoluto sobre la
     capa: no comparten flujo, cada uno se ubica contra la pantalla. */
  .wordmark__fondo {
    position: absolute;
    left: 0;
    top: 58%;
    transform: translateY(-50%);
    margin: 0;
    padding-left: 0.02em;
    font-family: var(--font-hero-display);
    font-weight: 900;
    font-size: 19vw;
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-petal);
    user-select: none;
    will-change: opacity;
  }

  /* El hueco de la credencial, en 2:3. El lienzo 3D se encuadra con este
     rectángulo, así que moverlo mueve la tarjeta. El techo en vw es para
     pantallas angostas, donde 60svh de alto daría una tarjeta más ancha
     que la pantalla. */
  .wordmark__photo {
    position: absolute;
    left: 50%;
    top: 54%;
    transform: translate(-50%, -50%);
    margin: 0;
    height: min(60svh, 100vw);
    aspect-ratio: 2 / 3;
    will-change: opacity;
  }

  /* ── La credencial plana ──────────────────────────────────────────────
     La de las pantallas táctiles, o la de escritorio si WebGL no está. No
     se muestra hasta que el script dibujó las caras (`.es-plana`): así no
     cae una tarjeta vacía. Con el 3D montado (`.es-3d`) no se muestra nunca. */
  .credencial__colgante {
    display: none;
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 1400px;
    /* El giro del balanceo pivota bien arriba, donde estaría el gancho. */
    transform-origin: 50% -60svh;
  }
  .credencial.es-plana .credencial__colgante {
    display: block;
    animation: credencial-caida 1.7s cubic-bezier(0.3, 0.7, 0.4, 1) both;
  }

  .credencial__cinta {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 4px);
    width: 16%;
    height: 100svh;
    transform: translateX(-50%);
    background-color: var(--color-rosewood);
    background-size: 100% auto;
    background-repeat: repeat-y;
    background-position: bottom center;
  }

  .credencial__tarjeta {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-style: preserve-3d;
    /* Con rebote: pasa de largo y vuelve, como la 3D. */
    transition: transform 0.8s cubic-bezier(0.3, 1.45, 0.5, 1);
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .credencial__tarjeta.is-volteada {
    transform: rotateY(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .credencial__tarjeta:hover {
      transform: rotateY(180deg);
    }
  }
  .credencial__tarjeta:focus-visible {
    outline: 2px solid var(--color-rosewood);
    outline-offset: 6px;
  }

  .credencial__cara {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 5%/3.3%;
    backface-visibility: hidden;
    box-shadow: 0 24px 50px -26px rgb(0 0 0 / 0.45);
  }
  .credencial__cara--dorso {
    transform: rotateY(180deg);
  }
  .credencial__cara :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes credencial-caida {
    0% {
      transform: translateY(-120svh) rotate(6deg);
    }
    55% {
      transform: translateY(3%) rotate(-4deg);
    }
    72% {
      transform: translateY(-1%) rotate(2.5deg);
    }
    88% {
      transform: rotate(-1deg);
    }
    100% {
      transform: none;
    }
  }

  .wordmark__pie {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(24px, 7svh, 64px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }

  .wordmark__rol {
    will-change: opacity;
  }
  .wordmark__rol-linea {
    margin: 0;
    font-family: var(--font-control);
    font-weight: 600;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  /* La segunda línea en cursiva y en coral: es el único toque de color
     cálido de la pantalla. Por su tamaño cuenta como texto grande para el
     contraste. */
  .wordmark__rol-extra {
    margin: 0.05em 0 0;
    font-family: var(--font-control-cursive);
    font-weight: var(--font-weight-medium);
    font-size: clamp(1.625rem, 2.3vw, 2.25rem);
    line-height: 1;
    color: var(--color-coral);
  }

  .wordmark__ctas {
    display: flex;
    gap: var(--element-gap);

    /* ── La excepción de la capa ────────────────────────────────────────
       `.wordmark__layer` es `pointer-events: none` entera, porque pasa por
       delante de la página. Estos dos botones tienen que recibir clicks,
       así que se los devuelve acá.

       Y por eso el script los apaga cuando se desvanecen: quedan en pantalla
       hasta que la capa se oculta al final, y un botón invisible que
       igual se puede clickear es una trampa. */
    pointer-events: auto;
    will-change: opacity;
  }

  /* En el teléfono la tarjeta sube un poco para dejarle lugar al pie, y el
     pie se apila: el rol arriba, los botones debajo. */
  @media (max-width: 600px) {
    .wordmark__fondo {
      top: 46%;
      font-size: 34vw;
    }
    .wordmark__photo {
      top: 42%;
      height: min(52svh, 96vw);
    }
    .wordmark__pie {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ── Entrada, y por qué solo toca `opacity` ───────────────────────────
     Las capas aparecen al cargar, antes de que haya scroll. De ahí en
     adelante todo lo maneja el scroll, escribiendo `transform` y `opacity`
     inline desde el script.

     Y ahí está la trampa que hay que respetar: una animación CSS con
     `fill-mode: both` sigue imponiendo el valor de su último keyframe
     DESPUÉS de terminar, y le gana a cualquier estilo inline — las
     animaciones pisan al autor en la cascada. Por eso las entradas se
     apagan (`.is-live`) en cuanto hay scroll o en cuanto terminan, lo que
     pase primero. Recién ahí el script puede mover las opacidades.

     El apagado no produce salto: el estado base del CSS es exactamente el
     último keyframe de cada animación. */
  :global(html.js) .wordmark__photo,
  :global(html.js) [data-wordmark-role],
  :global(html.js) .wordmark__ctas,
  :global(html.js) .wordmark__fondo,
  :global(html.js) .wordmark__glow {
    animation: wordmark-in 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* En cascada, mientras la credencial cae: el nombre de fondo, el rol y
     los botones. */
  :global(html.js) [data-wordmark-role] {
    animation-delay: 0.35s;
  }
  :global(html.js) .wordmark__ctas {
    animation-delay: 0.6s;
  }
  :global(html.js) .wordmark__fondo {
    animation-delay: 0.15s;
  }

  .wordmark__layer.is-live .wordmark__photo,
  .wordmark__layer.is-live [data-wordmark-role],
  .wordmark__layer.is-live .wordmark__ctas,
  .wordmark__layer.is-live .wordmark__fondo,
  .wordmark__layer.is-live .wordmark__glow {
    animation: none;
  }

  @keyframes wordmark-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

</style>

<script>
  import { TOUCH_QUERY } from '../lib/tactil';
  import type { Credencial3D } from '../lib/credencial3d';

  // ── La salida de la apertura ────────────────────────────────────────────
  // Ver el comentario del frontmatter para el porqué de la estructura. Acá
  // va el cómo.

  const panel = document.querySelector<HTMLElement>('[data-wordmark]');
  const layer = document.querySelector<HTMLElement>('[data-wordmark-layer]');
  const glow = document.querySelector<HTMLElement>('[data-wordmark-glow]');
  const fondo = document.querySelector<HTMLElement>('[data-wordmark-fondo]');
  const photo = document.querySelector<HTMLElement>('[data-wordmark-photo]');
  const role = document.querySelector<HTMLElement>('[data-wordmark-role]');
  const ctas = document.querySelector<HTMLElement>('[data-wordmark-ctas]');

  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const desmontar = () => {
    // Sin la pieza, el hero vuelve a ser lo primero y el logo de la nav se
    // comporta como siempre.
    panel?.remove();
    layer?.remove();
    document.documentElement.classList.remove('wordmark-activo');
  };

  if (!panel || !layer || quieto) {
    desmontar();
  } else {
    // Marca que la pieza está viva. La consume el hero (desmontado), que
    // retiene su animación de entrada hasta que la apertura empieza a irse.
    document.documentElement.classList.add('wordmark-activo');

    // La credencial 3D, si llegó a montarse. Sin ella queda la plana, que
    // vive adentro de `photo` y se apaga con él.
    let credencial3d: Credencial3D | null = null;
    const tarjeta = photo?.querySelector<HTMLElement>('[data-tarjeta]');

    let pendiente = false;
    let aterrizado: boolean | null = null;

    // Apaga las animaciones de entrada para que el script pueda escribir
    // `opacity` inline sin que el `fill-mode: both` se la pise. Ver el
    // comentario largo en el bloque de estilos.
    let vivo = false;
    const activar = () => {
      if (vivo) return;
      vivo = true;
      layer.classList.add('is-live');
    };
    // Tiene que esperar a la entrada MÁS LARGA de todas, que ahora es la de
    // la pista: 1.35s de espera más 1.1s de fundido. Si se apagara antes, la
    // pista quedaría clavada a mitad de camino.
    setTimeout(activar, 2550);

    const pintar = () => {
      pendiente = false;

      // El recorrido dura exactamente la altura del espaciador: cuando el
      // espaciador terminó de salir por arriba, la apertura ya se fue.
      const recorrido = panel.offsetHeight || window.innerHeight;
      const crudo = Math.min(1, Math.max(0, window.scrollY / recorrido));

      // Todo se apaga en la primera mitad del recorrido, así Proyectos entra
      // en una pantalla limpia. Solo se toca una vez apagada la entrada, que
      // hasta entonces manda sobre opacity.
      if (vivo) {
        if (glow) glow.style.opacity = String(Math.max(0, 1 - crudo * 1.6));
        // La credencial y el texto se apagan juntos y más rápido que el
        // rubor: son figura, no fondo.
        const visible = Math.max(0, 1 - crudo * 2.4);
        const acompanan = String(visible);
        if (photo) photo.style.opacity = acompanan;
        if (fondo) fondo.style.opacity = acompanan;
        credencial3d?.opacidad(visible);
        // Mismo motivo que los botones de abajo: invisible no se toca.
        if (tarjeta) tarjeta.style.pointerEvents = visible > 0.05 ? '' : 'none';
        if (role) role.style.opacity = acompanan;
        if (ctas) {
          ctas.style.opacity = acompanan;
          // Apagados apenas dejan de verse. Si no, siguen siendo
          // clickeables —invisibles, pero ahí— hasta que la capa entera se
          // oculta al final del recorrido.
          ctas.style.pointerEvents = visible > 0.05 ? 'auto' : 'none';
        }
      }

      // La cinta sube con el scroll y la tarjeta la sigue colgando. Va fuera
      // del `if (vivo)`: no es opacidad, así que no pelea con la entrada.
      credencial3d?.desplazar(window.scrollY);

      // El final. Se hace una sola vez por cambio de estado y no en cada
      // frame, para no tocar el DOM sesenta veces por segundo.
      const llego = crudo >= 0.999;
      if (llego !== aterrizado) {
        aterrizado = llego;
        // La capa es fija: una vez recorrida se oculta para no quedar
        // encima de la página.
        layer.style.visibility = llego ? 'hidden' : 'visible';
      }

      // El hero suelta su animación de entrada cuando la apertura ya se fue
      // lo suficiente como para que el hero esté entrando en pantalla. Si no,
      // su entrada se reproduce sola en una pantalla que nadie está mirando.
      if (crudo >= 0.4) {
        document.documentElement.classList.remove('wordmark-activo');
      }
    };

    const alScrollear = () => {
      // Scrollear es la señal de que la entrada ya no importa: si el usuario
      // se movió antes de que terminara, gana el viaje.
      if (window.scrollY > 0) activar();
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(pintar);
    };

    // Las fuentes mueven la fila al terminar de cargar, y con ella el hueco
    // donde cuelga la credencial. Se vuelve a medir cuando eso pasa.
    const remedir = () => {
      credencial3d?.medir();
      pintar();
    };

    pintar();

    document.fonts?.ready.then(remedir);

    // La credencial: 3D en escritorio, plana en táctil (Three.js pesa y en
    // un teléfono cuesta frames). Las caras se dibujan antes, así que cae
    // ya impresa.
    if (photo) {
      import('../lib/credencial')
        .then(({ montarCredencial }) =>
          montarCredencial(photo, layer, !window.matchMedia(TOUCH_QUERY).matches),
        )
        .then((montada) => {
          credencial3d = montada;
          pintar();
        })
        .catch(() => {});
    }

    addEventListener('scroll', alScrollear, { passive: true });
    addEventListener('resize', remedir, { passive: true });
  }
</script>
