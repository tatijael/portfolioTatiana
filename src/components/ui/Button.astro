---
/**
 * Botón del sistema Air.
 *  - ghost: transparente + borde 1px blanco  → sobre canvas oscuro
 *  - light: relleno Haze + borde Ink         → sobre superficies claras
 * No existe una variante sólida de color: es una regla del sistema.
 */
interface Props {
  href: string;
  variant?: 'ghost' | 'light';
  class?: string;
  external?: boolean;
}

const { href, variant = 'ghost', class: className = '', external = false } = Astro.props;

const base = variant === 'light' ? 'air-btn-light' : 'air-btn-ghost';
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a href={href} class={`${base} ${className}`} rel={rel} target={target}>
  <slot />
</a>
