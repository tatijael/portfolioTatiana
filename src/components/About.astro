---
import { cvUrl, education, experience, languages } from '../data/site';
---

<section
  id="experiencia"
  class="py-[var(--section-pad)] md:py-[var(--section-pad-lg)]"
>
  <div class="air-container flex flex-col gap-[var(--section-gap)]">
    {/* ── Experiencia ── */}
    <div class="flex flex-col gap-8">
      <div class="air-reveal flex flex-wrap items-center justify-between gap-4">
        <h3 class="air-eyebrow">Experiencia</h3>
        {
          cvUrl && (
            <a
              href={cvUrl}
              class="air-btn-ghost px-5 py-2.5"
              download="Tatiana-Saucedo-CV.pdf"
            >
              Descargar CV
            </a>
          )
        }
      </div>

      <ol class="flex flex-col gap-6">
        {
          experience.map((job) => (
            <li class="air-reveal air-card air-card--haze grid gap-4 md:grid-cols-[220px_1fr] md:gap-8">
              <div class="flex flex-col gap-1">
                <p class="type-xl-3 text-ink">{job.role}</p>
                <p class="text-caption font-medium text-rosewood">
                  {job.company}
                </p>
                <p class="text-caption font-normal text-ink/70">{job.period}</p>
                <p class="text-caption font-normal text-ink/70">{job.place}</p>
              </div>

              <ul class="flex flex-col gap-2">
                {job.bullets.map((b) => (
                  <li class="flex gap-3 text-body font-normal text-ink/75">
                    <span class="mt-2 h-px w-4 shrink-0 bg-ink/30" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }

        <li class="air-reveal air-card air-card--haze grid gap-4 md:grid-cols-[220px_1fr] md:gap-8">
          <p class="type-xl-3 text-ink">Formación</p>
          <ul class="flex flex-col gap-4">
            {education.map((ed) => (
              <li class="flex flex-col gap-1">
                <p class="text-body font-medium text-ink">{ed.title}</p>
                <p class="text-caption font-medium text-rosewood">{ed.school}</p>
                {ed.period && (
                  <p class="text-caption font-normal text-ink/70">{ed.period}</p>
                )}
                {ed.detail && (
                  <p class="text-caption font-normal text-ink/75">{ed.detail}</p>
                )}
              </li>
            ))}
          </ul>
        </li>

        <li class="air-reveal air-card air-card--haze grid gap-4 md:grid-cols-[220px_1fr] md:gap-8">
          <p class="type-xl-3 text-ink">Idiomas</p>
          <ul class="flex flex-col gap-2">
            {languages.map((l) => (
              <li class="flex flex-wrap items-baseline gap-x-3">
                <span class="text-body font-medium text-ink">{l.label}</span>
                <span class="text-caption font-normal text-ink/70">{l.level}</span>
              </li>
            ))}
          </ul>
        </li>
      </ol>
    </div>
  </div>
</section>
